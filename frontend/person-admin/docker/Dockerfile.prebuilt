FROM node:24.11.1-bookworm-slim AS runtime-base
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000
USER node
EXPOSE 3000
CMD ["node", "frontend/person-admin/server.js"]

FROM runtime-base AS runtime-prebuilt
COPY --chown=node:node frontend/person-admin/.next/standalone/ /app/
COPY --chown=node:node frontend/person-admin/.next/static /app/frontend/person-admin/.next/static
COPY --chown=node:node frontend/person-admin/public /app/frontend/person-admin/public
