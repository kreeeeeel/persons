{
    "name": "@persons/person",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "cross-env APP_ENV=dev node tools/next.ts dev --hostname 0.0.0.0 --port 3002",
        "lint": "eslint src tools tests *.ts",
        "lint:shared": "node tools/check-shared.ts",
        "lint:styles": "stylelint \"src/**/*.css\" \"../libs/**/*.css\"",
        "format:check": "prettier --check src tools tests *.ts *.json",
        "typecheck": "node tools/next.ts typegen && tsc --noEmit",
        "test": "vitest run",
        "test:preview": "node --test tools/preview-content.test.mts",
        "test:e2e": "playwright test",
        "build": "node tools/next.ts build",
        "start": "node tools/start-frontend.ts",
        "build:testing": "cross-env APP_ENV=testing node tools/next.ts build",
        "start:testing": "cross-env APP_ENV=testing node tools/start-frontend.ts",
        "build:prod": "cross-env APP_ENV=prod node tools/next.ts build",
        "start:prod": "cross-env APP_ENV=prod node tools/start-frontend.ts",
        "check": "npm run lint && npm run lint:shared && npm run lint:styles && npm run format:check && npm run typecheck && npm run test",
        "format": "prettier --write src tools tests *.ts *.json \"../libs/*/src/**/*.{ts,tsx,css,json}\"",
        "generate": "node tools/gradle.ts generateClients",
        "backend:build": "node tools/gradle.ts build",
        "backend:format": "node tools/gradle.ts ktlintFormat",
        "assets": "node tools/sync-assets.ts",
        "prebuild": "npm run assets",
        "prebuild:testing": "npm run assets",
        "prebuild:prod": "npm run assets",
        "predev": "npm run assets"
    },
    "dependencies": {
        "@gravity-ui/icons": "2.22.0",
        "@gravity-ui/uikit": "7.51.0",
        "@persons/assets": "file:../assets",
        "@persons/dynamic-properties": "file:../libs/dynamic-properties",
        "@persons/dynamic-properties-client": "file:../../backend/libs/dynamic-properties/contract/client/typescript",
        "@persons/i18n": "file:../libs/i18n",
        "@persons/i18n-client": "file:../../backend/i18n/app/contract/client/typescript",
        "@persons/id-client": "file:../../backend/id/app/contract/client/typescript",
        "@persons/person-client": "file:../../backend/person/app/contract/client/typescript",
        "@persons/person-domain": "file:../libs/person-domain",
        "@persons/photo-editor": "file:../libs/photo-editor",
        "@persons/theme": "file:../libs/theme",
        "@persons/ui": "file:../libs/ui",
        "next": "16.4.1",
        "next-intl": "4.14.9",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-easy-crop": "6.2.4",
        "server-only": "0.0.1",
        "zod": "4.1.12"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.7",
        "@types/node": "24.10.1",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.1.2",
        "cross-env": "10.1.0",
        "eslint": "9.39.1",
        "eslint-config-next": "16.4.1",
        "jiti": "2.6.1",
        "jsdom": "28.1.0",
        "prettier": "3.9.9",
        "stylelint": "16.26.1",
        "stylelint-config-css-modules": "4.5.1",
        "stylelint-config-standard": "39.0.1",
        "tsx": "4.20.6",
        "typescript": "5.9.3",
        "vite": "8.3.3",
        "vitest": "5.0.3"
    },
    "engines": {
        "node": ">=24.11.1 <25",
        "npm": ">=11 <12"
    }
}
