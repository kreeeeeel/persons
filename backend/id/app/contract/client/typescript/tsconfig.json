{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "declaration": true,
        "strict": true,
        "skipLibCheck": true,
        "outDir": ".build/dist",
        "rootDir": ".build/generated/openapi"
    },
    "include": [
        ".build/generated/openapi/**/*.ts"
    ]
}
