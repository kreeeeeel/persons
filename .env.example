DB_PASSWORD=replace-with-a-random-password
MINIO_ROOT_USER=persons
MINIO_ROOT_PASSWORD=replace-with-a-random-password
ID_PEPPER=replace-with-at-least-32-random-characters
ID_JWT_SECRET=replace-with-at-least-32-random-characters
PROJECT_INTERNAL_JWT_SECRET=replace-with-at-least-32-random-characters
PROJECT_GATEWAY_JWT_SECRET=replace-with-a-different-32-character-secret
REDIS_PASSWORD=replace-with-a-random-password
PERSONS_ADMIN_EMAIL=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:3000/api/oauth/yandex/callback
PUBLIC_ID_URL=http://localhost:3000
PUBLIC_ADMIN_URL=http://localhost:3001
PUBLIC_PERSON_URL=http://localhost:3002
# Production only: base domain shared by the three HTTPS frontends, without scheme.
SESSION_COOKIE_DOMAIN=
SMTP_HOST=mailpit
LEETIFY_API_KEY=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_STARTTLS_REQUIRED=false
MAIL_FROM=Персонажи <hello@persons.local>

# External storage only: add docker/compose.external-s3.yaml after the production file,
# and set /opt/persons/shared/storage-profile to external. Leave these unset for MinIO.
# S3_ENDPOINT=https://s3.example.test
# S3_REGION=default
# S3_BUCKET=project-bucket
# S3_ACCESS_KEY=provided-by-storage
# S3_SECRET_KEY=provided-by-storage
# ASSET_BASE_URL=https://s3.example.test/project-bucket/assets
